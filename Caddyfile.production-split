{
	# Values are supplied by the external operations environment, never Git.
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}

https://{$SSO_DOMAIN} {
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://{$SSO_DOMAIN}; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"
	@identity_api path /.well-known/* /oauth2/* /oidc/* /api/v1/* /readiness
	handle @identity_api {
		reverse_proxy gosso:8080 {
			header_up Host {$SSO_DOMAIN}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
	handle {
		reverse_proxy gosso-admin-frontend:8083 {
			header_up Host {$SSO_DOMAIN}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

https://{$BLOG_DOMAIN} {
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://{$SSO_DOMAIN}; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"
	@blog_backend path /api/* /feed.xml /rss /sitemap.xml /media/* /swagger*
	handle @blog_backend {
		reverse_proxy blog-backend:8082 {
			header_up Host {$BLOG_DOMAIN}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
	handle {
		reverse_proxy blog-frontend:8081 {
			header_up Host {$BLOG_DOMAIN}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

https://{$CMS_DOMAIN} {
	import security_headers
	respond "CMS client is reserved but not deployed" 404
}
