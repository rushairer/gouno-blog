{
	# Production Caddy configuration for io84.com multi-domain split
	email {$ACME_EMAIL:admin@io84.com}
}

(security_headers) {
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}

# 1. Identity Provider & Admin Portal (sso.io84.com)
https://sso.io84.com {
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://sso.io84.com; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"

	# OIDC Discovery, OAuth2, and GOSSO Management APIs
	@identity_api path /.well-known/* /oauth2/* /oidc/* /api/v1/* /readiness
	handle @identity_api {
		reverse_proxy gosso:8080 {
			header_up Host sso.io84.com
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	# Hosted Admin & Account Settings UI
	handle {
		reverse_proxy gosso-admin-frontend:8083 {
			header_up Host sso.io84.com
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

# 2. Personal Blog & Confidential BFF (blog.io84.com)
https://blog.io84.com {
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://sso.io84.com; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"

	# Blog Backend API, Media, Feeds & BFF endpoints
	@blog_backend path /api/* /feed.xml /rss /sitemap.xml /media/* /swagger*
	handle @blog_backend {
		reverse_proxy blog-backend:8082 {
			header_up Host blog.io84.com
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	# Blog React Frontend SPA
	handle {
		reverse_proxy blog-frontend:8081 {
			header_up Host blog.io84.com
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

# 3. Reserved CMS Domain (cms.io84.com)
https://cms.io84.com {
	import security_headers
	respond "CMS client is reserved but not deployed" 404
}

# 4. Legacy Origin Transition & Rollback Window (io84.com)
https://io84.com {
	import security_headers
	redir https://blog.io84.com{uri} permanent
}
