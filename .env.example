# Local Docker HTTPS gateway. Run ./scripts/setup-local-tls.sh before docker compose up.
LOCAL_TLS_CERT_FILE=./certs/localhost.pem
LOCAL_TLS_KEY_FILE=./certs/localhost-key.pem

# Cookie-session OAuth client and blog API verifier.
VITE_GOSSO_ISSUER=https://localhost:8443
VITE_GOSSO_CLIENT_ID=blog-spa
VITE_GOSSO_SCOPE=openid profile email admin
SSO_TOKEN_ISSUER=https://localhost:8443
SSO_TOKEN_AUDIENCE=blog-spa
SSO_CLIENT_ID=blog-spa
BLOG_IDENTITY_ISSUER_MIGRATIONS={"https://sso.dev.local":"https://localhost:8443"}

# Split-origin BFF development configuration (local split profile)
# Set these after generating secrets with: ./scripts/setup-local-tls.sh
BLOG_BFF_ENABLED=true
BLOG_OIDC_ISSUER=https://sso.dev.local
BLOG_OIDC_CLIENT_ID=blog-bff
BLOG_OIDC_CLIENT_SECRET=blog-bff-secret-local
BLOG_OIDC_REDIRECT_URL=https://blog.dev.local/api/auth/callback
BLOG_OIDC_POST_LOGOUT_URL=https://blog.dev.local/api/auth/logout/callback
BLOG_OIDC_RESOURCE=https://blog.dev.local/api
BLOG_OIDC_SCOPES=openid profile email
BLOG_BFF_TINK_KEYSET_PATH=/run/secrets/blog-bff-tink.json

# Optional non-secret local overrides.
BLOG_POSTGRES_PASSWORD=password
VITE_SHOW_DEV_CREDENTIALS=true
