{
  "name": "blog-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-static-chunk-cycles.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "oxlint",
    "lint:ui": "node scripts/check-ui-contracts.mjs",
    "test": "vitest",
    "test:run": "tsc -b && vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && tsc -b && oxlint src && npm run test:coverage",
    "quality": "npm run format:check && npm run lint && npm run lint:ui && npm run lint:css && tsc -b && npm run test:coverage && npm run build",
    "preview": "vite preview",
    "lint:css": "node scripts/check-css-cascade.mjs"
  },
  "dependencies": {
    "@gosso/client": "0.9.3",
    "@gouno/ui": "0.3.5",
    "@tailwindcss/vite": "^4.3.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.9",
    "jsdom": "^29.1.1",
    "oxlint": "^1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
