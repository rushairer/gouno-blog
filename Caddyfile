{
	auto_https off
}

(security_headers) {
	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}

# Split-origin local development topology (.dev.local)
https://sso.dev.local, https://sso.dev.local:443 {
	tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://sso.dev.local https://sso.dev.local:443; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"

	@identity_api path /.well-known/* /oauth2/* /oidc/* /api/v1/* /readiness
	handle @identity_api {
		reverse_proxy gosso:8080 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy gosso-admin-frontend:8083 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

https://blog.dev.local, https://blog.dev.local:443 {
	tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
	import security_headers
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; form-action 'self' https://sso.dev.local https://sso.dev.local:443; frame-ancestors 'self'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"

	@blog_backend path /api/* /feed.xml /rss /sitemap.xml /media/* /swagger*
	handle @blog_backend {
		reverse_proxy blog-backend:8082 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}

	handle {
		reverse_proxy blog-frontend:8081 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {http.request.remote.host}
		}
	}
}

https://cms.dev.local, https://cms.dev.local:443 {
	tls /etc/caddy/certs/localhost.pem /etc/caddy/certs/localhost-key.pem
	import security_headers
	respond "CMS client is reserved but not deployed" 404
}

