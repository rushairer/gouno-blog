# Copy this file to .env.production and fill every value.
# Image values must use immutable version@sha256 digest.
# Example: ghcr.io/owner/image:1.2.3@sha256:<64 lowercase hex characters>

COMPOSE_PROJECT_NAME=gouno-blog-prod
SSO_DOMAIN=sso.io84.com
BLOG_DOMAIN=blog.io84.com
CMS_DOMAIN=cms.io84.com
ACME_EMAIL=ops@io84.com

# Container Images
POSTGRES_IMAGE=pgvector/pgvector:pg15@sha256:a20a57d7aa5217a6af0a391ccf69f4a8512406d6c14be08132f801468cc3cc62
REDIS_IMAGE=redis:7-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
CADDY_IMAGE=caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d
GOSSO_IMAGE=ghcr.io/rushairer/gosso:v0.8.0@sha256:<GOSSO_DIGEST>
GOSSO_ADMIN_SEED_IMAGE=ghcr.io/rushairer/gosso-admin-seed:v0.6.0@sha256:<ADMIN_SEED_DIGEST>
GOSSO_ADMIN_FRONTEND_IMAGE=ghcr.io/rushairer/gosso-admin-frontend:v0.6.0@sha256:<ADMIN_FRONTEND_DIGEST>
GOUNO_BLOG_SEED_IMAGE=ghcr.io/rushairer/gouno-blog-seed:v1.0.0@sha256:<BLOG_SEED_DIGEST>
GOUNO_BLOG_BACKEND_IMAGE=ghcr.io/rushairer/gouno-blog-backend:v1.0.0@sha256:<BLOG_BACKEND_DIGEST>
GOUNO_BLOG_FRONTEND_IMAGE=ghcr.io/rushairer/gouno-blog-frontend:v1.0.0@sha256:<BLOG_FRONTEND_DIGEST>

# Network & Ports
HTTP_PORT=80
HTTPS_PORT=443

# Databases & Redis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<SECURE_DATABASE_PASSWORD>
POSTGRES_DB=gosso
BLOG_POSTGRES_DB=blog
REDIS_PASSWORD=<SECURE_REDIS_PASSWORD>

GOSSO_DATABASE_DSN=host=db user=postgres password=<SECURE_DATABASE_PASSWORD> dbname=gosso port=5432 sslmode=disable TimeZone=Asia/Shanghai search_path=public
BLOG_DATABASE_DSN=host=db user=postgres password=<SECURE_DATABASE_PASSWORD> dbname=blog port=5432 sslmode=disable TimeZone=Asia/Shanghai search_path=public
GOSSO_REDIS_DSN=redis://:<SECURE_REDIS_PASSWORD>@redis:6379/0
BLOG_REDIS_DSN=redis://:<SECURE_REDIS_PASSWORD>@redis:6379/1

# GOSSO Secrets & Security
GOSSO_CORS_ALLOWED_ORIGINS=https://sso.io84.com
# Exact comma-separated CIDR list for reverse-proxy / container network
GOSSO_TRUSTED_PROXIES=172.21.0.0/16
# Back-channel logout SSRF allowed CIDRs (set container subnet e.g. 172.21.0.0/16 for internal routing)
GOSSO_BACKCHANNEL_ALLOWED_CIDRS=172.21.0.0/16
SMTP_FROM_EMAIL=no-reply@io84.com
SMTP_FROM_NAME="IO84 SSO"

# GOSSO Admin Initial Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<SECURE_ADMIN_PASSWORD>
ADMIN_DISPLAY_NAME=System Admin

# Blog BFF Configuration
BLOG_OIDC_CLIENT_ID=blog-bff
BLOG_OAUTH_OWNER_ID=c6ac32f3-3c48-46b5-bae8-f17c17116dc5
BLOG_BOOTSTRAP_OWNER_SUBJECT=c6ac32f3-3c48-46b5-bae8-f17c17116dc5
BLOG_VISITOR_SECRET=<32_BYTE_RANDOM_SECRET>
GOUNO_AI_WEBHOOK_SECRET=<32_BYTE_RANDOM_SECRET>

# Secret File Paths (Mounted read-only inside containers via Docker Secrets)
GOSSO_SIGNING_KEY_FILE=/opt/gouno-blog/secrets/gosso_private.pem
GOSSO_TOTP_KEY_FILE=/opt/gouno-blog/secrets/gosso_totp_key
GOSSO_VERIFY_PEPPER_FILE=/opt/gouno-blog/secrets/gosso_verify_pepper
BLOG_BFF_TINK_KEYSET_FILE=/opt/gouno-blog/secrets/blog-bff-tink.json
BLOG_OAUTH_CLIENT_SECRET_FILE=/opt/gouno-blog/secrets/blog_oauth_client_secret
BLOG_AGENT_MASTER_KEY_FILE=/opt/gouno-blog/secrets/blog_agent_master_key

# External Volume Names
POSTGRES_VOLUME_NAME=gouno_prod_db_data
REDIS_VOLUME_NAME=gouno_prod_redis_data
BLOG_MEDIA_VOLUME_NAME=gouno_prod_blog_media
CADDY_DATA_VOLUME_NAME=gouno_prod_caddy_data
CADDY_CONFIG_VOLUME_NAME=gouno_prod_caddy_config
