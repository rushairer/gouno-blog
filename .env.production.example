# Copy this file and fill every value. Image values must use version@sha256.
# Example: ghcr.io/owner/image:1.2.3@sha256:<64 lowercase hex characters>
POSTGRES_IMAGE=
REDIS_IMAGE=
CADDY_IMAGE=
GOSSO_IMAGE=
GOSSO_ADMIN_SEED_IMAGE=
GOSSO_ADMIN_FRONTEND_IMAGE=
GOUNO_BLOG_SEED_IMAGE=
GOUNO_BLOG_BACKEND_IMAGE=
GOUNO_BLOG_FRONTEND_IMAGE=

PUBLIC_ORIGIN=https://blog.example.com
HTTPS_PORT=8443
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_PASSWORD=
GOSSO_DATABASE_DSN=
GOSSO_REDIS_DSN=
BLOG_DATABASE_DSN=
BLOG_REDIS_DSN=
GOSSO_TOTP_KEY=
GOSSO_VERIFY_PEPPER=
GOSSO_CORS_ALLOWED_ORIGINS=
# Exact comma-separated CIDR list for only the reverse-proxy/container network,
# for example 10.89.1.0/24. A wrong subnet collapses all clients into the proxy
# IP and makes authentication rate limits global to every visitor.
GOSSO_TRUSTED_PROXIES=
ADMIN_USERNAME=
ADMIN_PASSWORD=
SSO_CLIENT_ID=
BLOG_VISITOR_SECRET=
BLOG_AGENT_MASTER_KEY=
GOUNO_AI_WEBHOOK_SECRET=
GOSSO_SIGNING_KEY_FILE=
TLS_CERT_FILE=
TLS_KEY_FILE=
